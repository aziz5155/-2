{
  "expo": {
    "name": "العائلة الناجحة",
    "slug": "family-success",
    "version": "1.0.0",
    "scheme": "familysuccess",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#4F46E5",
    "backgroundColor": "#F8F9FC",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familysuccess.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "نستخدم الكاميرا لالتقاط صورة شخصية للطفل أو ولي الأمر.",
        "NSPhotoLibraryUsageDescription": "نحتاج الوصول للصور لاختيار صورة شخصية للطفل أو ولي الأمر.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.familysuccess.app",
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-localization",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج الوصول للصور لاختيار صورة شخصية.",
          "cameraPermission": "نستخدم الكاميرا لالتقاط صورة شخصية."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
