# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it stays out of git via .gitignore.

# --- Supabase (required) ---------------------------------------------------
# Project Settings → API in your Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Sign-In (optional, parent auth) --------------------------------
# From Google Cloud Console → APIs & Services → Credentials.
# Web client ID is also used as the Supabase Google provider's client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Server-side only (Supabase Edge Functions) ----------------------------
# Set these as Supabase project secrets (never in the app / EXPO_PUBLIC_*):
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_URL and SUPABASE_ANON_KEY are provided automatically to edge
# functions by Supabase; only the service role key needs to be set manually.
